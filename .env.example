VITE_SUPABASE_URL=https://your-project.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Client ID of the GitHub OAuth App used for Studio sign-in. Not secret —
# only the app's Client Secret (set as a Supabase edge function secret,
# never here) needs to stay private.
VITE_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
